datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum Role {
  ADMIN
  VENDOR
  USER
}

enum ProductType {
  NEW_ARRIVAL
  FEATURED_PRODUCT
  TOP_PRODUCT
  BEST_PRODUCT
}

enum OrderStatus {
  PENDING
  PROCESSED_AND_READY_TO_SHIP
  DROPPED_OFF
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum WithdrawStatus {
  PENDING
  PAID
  DECLINED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

// ==========================================
// 2. USER & AUTH DOMAIN
// ==========================================

model User {
  id               String          @id @default(uuid())
  name             String
  email            String          @unique
  password         String?
  role             Role            @default(USER)
  status           Boolean         @default(true)
  phone            String?
  avatar           String?
  googleId         String?         @unique
  githubId         String?         @unique
  facebookId       String?         @unique
  twitterId        String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  vendor           Vendor?
  addresses        UserAddress[]
  orders           Order[]
  reviews          ProductReview[]
  wishlists        Wishlist[]
  blogComments     BlogComment[]
  sentMessages     Chat[]          @relation("SentMessages")
  receivedMessages Chat[]          @relation("ReceivedMessages")

  @@index([email])
  @@index([role])
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String
  name        String
  email       String
  phone       String
  country     String
  state       String
  city        String
  zipCode     String
  address     String
  addressType String   @default("home") // home / office
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 3. VENDOR & PAYOUT DOMAIN
// ==========================================

model Vendor {
  id               String            @id @default(uuid())
  userId           String            @unique
  shopName         String
  banner           String?
  phone            String?
  email            String?
  address          String?
  description      String?           @db.Text
  fbLink           String?
  twLink           String?
  instaLink        String?
  status           Boolean           @default(false) // false = pending admin approval, true = approved
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products         Product[]
  orderProducts    OrderProduct[]
  withdrawRequests WithdrawRequest[]

  @@index([userId])
  @@index([status])
}

model VendorCondition {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WithdrawMethod {
  id                   String            @id @default(uuid())
  name                 String
  minimumAmount        Float
  maximumAmount        Float
  withdrawChargePercent Float             @default(0)
  description          String?           @db.Text
  status               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  requests             WithdrawRequest[]
}

model WithdrawRequest {
  id             String         @id @default(uuid())
  vendorId       String
  methodId       String
  totalAmount    Float
  withdrawCharge Float
  finalAmount    Float          // totalAmount - withdrawCharge
  accountInfo    String         @db.Text
  status         WithdrawStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vendor         Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  method         WithdrawMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@index([vendorId])
  @@index([status])
}

// ==========================================
// 4. CATALOG & INVENTORY DOMAIN
// ==========================================

model Category {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  icon          String?
  status        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subCategories SubCategory[]
  products      Product[]

  @@index([slug])
}

model SubCategory {
  id              String          @id @default(uuid())
  categoryId      String
  name            String
  slug            String          @unique
  status          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  childCategories ChildCategory[]
  products        Product[]

  @@index([categoryId])
  @@index([slug])
}

model ChildCategory {
  id            String      @id @default(uuid())
  subCategoryId String
  name          String
  slug          String      @unique
  status        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  products      Product[]

  @@index([subCategoryId])
  @@index([slug])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logo      String?
  isFeatured Boolean  @default(false)
  status    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@index([slug])
}

model Product {
  id               String                @id @default(uuid())
  vendorId         String
  categoryId       String
  subCategoryId    String?
  childCategoryId  String?
  brandId          String?
  name             String
  slug             String                @unique
  thumbImage       String
  qty              Int                   @default(0)
  shortDescription String?               @db.Text
  longDescription  String?               @db.Text
  videoLink        String?
  sku              String?               @unique
  price            Float
  offerPrice       Float?
  offerStartDate   DateTime?
  offerEndDate     DateTime?
  productType      ProductType?
  status           Boolean               @default(true)
  isApproved       Boolean               @default(false) // Vendor products need Admin approval
  seoTitle         String?
  seoDescription   String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  vendor           Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category         Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory      SubCategory?          @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  childCategory    ChildCategory?        @relation(fields: [childCategoryId], references: [id], onDelete: SetNull)
  brand            Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  
  variants         ProductVariant[]
  imageGallery     ProductImageGallery[]
  orderProducts    OrderProduct[]
  reviews          ProductReview[]
  wishlists        Wishlist[]
  flashSaleProducts FlashSaleProduct[]

  @@index([slug])
  @@index([vendorId])
  @@index([categoryId])
  @@index([isApproved])
  @@index([status])
}

model ProductVariant {
  id        String               @id @default(uuid())
  productId String
  name      String               // e.g., "Size", "Color"
  status    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  items     ProductVariantItem[]

  @@index([productId])
}

model ProductVariantItem {
  id               String         @id @default(uuid())
  productVariantId String
  name             String         // e.g., "Small", "Red"
  price            Float          @default(0) // Extra modifier cost added to base price
  isDefault        Boolean        @default(false)
  status           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId])
}

model ProductImageGallery {
  id        String   @id @default(uuid())
  productId String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ==========================================
// 5. CHECKOUT, ORDERS & FINANCIAL SNAPSHOTS
// ==========================================

model Order {
  id             String         @id @default(uuid())
  invoiceId      Int            @unique // Numeric invoice identifier
  userId         String
  subTotal       Float
  amount         Float          // Final payable amount
  currencyName   String         @default("USD")
  currencyIcon   String         @default("$")
  productQty     Int
  paymentMethod  String         // e.g. "STRIPE", "PAYPAL", "RAZORPAY", "COD"
  paymentStatus  PaymentStatus  @default(UNPAID)
  orderStatus    OrderStatus    @default(PENDING)

  // Immutable JSON snapshots
  orderAddress   Json           // Full shipping & billing snapshot
  shippingMethod Json           // Selected shipping carrier & fee snapshot
  coupon         Json?          // Applied coupon code and discount snapshot

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderProducts  OrderProduct[]
  transaction    Transaction?

  @@index([userId])
  @@index([invoiceId])
  @@index([orderStatus])
  @@index([paymentStatus])
}

model OrderProduct {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  vendorId     String
  productName  String
  unitPrice    Float
  qty          Int
  variantTotal Float    @default(0)
  variants     Json?    // Snapshot of selected variants { Size: "XL", Color: "Red" }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
}

model Transaction {
  id                     String   @id @default(uuid())
  orderId                String   @unique
  transactionId          String   // Gateway charge/payment ID
  paymentMethod          String
  amount                 Float    // Amount in store base currency
  amountRealCurrency     Float    // Amount converted to gateway currency
  amountRealCurrencyName String   // e.g. "USD", "INR"
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  order                  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model Coupon {
  id              String       @id @default(uuid())
  name            String
  code            String       @unique
  quantity        Int
  maxUse          Int          @default(1)
  startDate       DateTime
  endDate         DateTime
  discountType    DiscountType @default(PERCENT)
  discount        Float
  totalUsed       Int          @default(0)
  status          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([code])
}

model ShippingRule {
  id        String   @id @default(uuid())
  name      String
  type      String   // "flat_cost", "min_cost"
  minCost   Float?   @default(0)
  cost      Float
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 6. REAL-TIME CHAT & SOCIAL
// ==========================================

model Chat {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  message    String   @db.Text
  seen       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, seen])
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int      @default(5)
  review    String   @db.Text
  status    Boolean  @default(false) // Moderated by admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ==========================================
// 7. MARKETING & CMS
// ==========================================

model FlashSale {
  id        String             @id @default(uuid())
  endDate   DateTime
  showAtHome Boolean           @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  products  FlashSaleProduct[]
}

model FlashSaleProduct {
  id          String    @id @default(uuid())
  flashSaleId String
  productId   String
  showAtHome  Boolean   @default(false)
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
}

model Advertisement {
  id        String   @id @default(uuid())
  key       String   @unique // homepage_banner_section_one, productpage_banner, etc.
  value     Json     // { banner: string, url: string, status: boolean }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Slider {
  id        String   @id @default(uuid())
  banner    String
  type      String?
  title     String?
  startingPrice Float?
  btnUrl    String?
  serial    Int      @default(1)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomePageSetting {
  id        String   @id @default(uuid())
  key       String   @unique // popular_category_section, product_slider_one, etc.
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String?
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogs     Blog[]
}

model Blog {
  id             String        @id @default(uuid())
  categoryId     String
  title          String
  slug           String        @unique
  image          String
  description    String        @db.Text
  seoTitle       String?
  seoDescription String?       @db.Text
  status         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category       BlogCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments       BlogComment[]

  @@index([slug])
}

model BlogComment {
  id        String   @id @default(uuid())
  blogId    String
  userId    String
  comment   String   @db.Text
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

// ==========================================
// 8. PLATFORM & GATEWAY SETTINGS
// ==========================================

model GeneralSetting {
  id           String   @id @default(uuid())
  siteName     String   @default("Multi-Vendor Marketplace")
  contactEmail String?
  contactPhone String?
  contactAddress String?
  mapUrl       String?  @db.Text
  currencyName String   @default("USD")
  currencyIcon String   @default("$")
  timeZone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailSetting {
  id          String   @id @default(uuid())
  email       String
  host        String
  username    String
  password    String
  port        Int      @default(587)
  encryption  String   @default("tls")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PusherSetting {
  id          String   @id @default(uuid())
  appId       String
  key         String
  secret      String
  cluster     String   @default("mt1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaypalSetting {
  id           String   @id @default(uuid())
  status       Boolean  @default(false)
  mode         String   @default("sandbox") // sandbox / live
  countryName  String?
  currencyName String   @default("USD")
  currencyRate Float    @default(1)
  clientId     String
  secretKey    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StripeSetting {
  id           String   @id @default(uuid())
  status       Boolean  @default(false)
  countryName  String?
  currencyName String   @default("USD")
  currencyRate Float    @default(1)
  clientId     String   // Publishable Key
  secretKey    String   // Secret Key
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RazorpaySetting {
  id              String   @id @default(uuid())
  status          Boolean  @default(false)
  countryName     String?
  currencyName    String   @default("INR")
  currencyRate    Float    @default(83)
  razorpayKey     String
  razorpaySecretKey String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CodSetting {
  id        String   @id @default(uuid())
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
