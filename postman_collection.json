            "body": { "mode": "raw", "raw": "{\n  \"status\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/vendor/products/:id/status", "host": ["{{baseUrl}}"], "path": ["api", "vendor", "products", ":id", "status"], "variable": [{ "key": "id", "value": "product_id" }] }
          }
        },
        {
          "name": "Get Product Variants",
          "request": {
            "method": "GET",
