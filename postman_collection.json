{
  "info": {
    "name": "Multi-Vendor E-Commerce Platform API",
    "_postman_id": "ecom-api-complete-suite-v1",
    "description": "Complete Postman collection covering all REST API endpoints across Customer Accounts, Storefront Discovery, Order & Checkout, Vendor Portal, Admin Control Panel, and Real-Time Chat.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Session (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Customer Portal (User)",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/profile", "host": ["{{baseUrl}}"], "path": ["api", "user", "profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"phone\": \"+1234567890\",\n  \"avatar\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/user/profile", "host": ["{{baseUrl}}"], "path": ["api", "user", "profile"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewSecurePass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/user/change-password", "host": ["{{baseUrl}}"], "path": ["api", "user", "change-password"] }
          }
        },
        {
          "name": "Get Saved Addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/addresses", "host": ["{{baseUrl}}"], "path": ["api", "user", "addresses"] }
          }
        },
        {
          "name": "Create Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"phone\": \"9876543210\",\n  \"country\": \"United States\",\n  \"state\": \"California\",\n  \"city\": \"Los Angeles\",\n  \"zipCode\": \"90001\",\n  \"address\": \"123 Ocean Blvd, Apt 4B\",\n  \"addressType\": \"home\",\n  \"isDefault\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/user/addresses", "host": ["{{baseUrl}}"], "path": ["api", "user", "addresses"] }
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"San Francisco\",\n  \"address\": \"456 Market St\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/user/addresses/:id", "host": ["{{baseUrl}}"], "path": ["api", "user", "addresses", ":id"], "variable": [{ "key": "id", "value": "address_id_here" }] }
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/addresses/:id", "host": ["{{baseUrl}}"], "path": ["api", "user", "addresses", ":id"], "variable": [{ "key": "id", "value": "address_id_here" }] }
          }
        },
        {
          "name": "Set Default Address",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/addresses/:id/default", "host": ["{{baseUrl}}"], "path": ["api", "user", "addresses", ":id", "default"], "variable": [{ "key": "id", "value": "address_id_here" }] }
          }
        },
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/wishlist", "host": ["{{baseUrl}}"], "path": ["api", "user", "wishlist"] }
          }
        },
        {
          "name": "Add Product to Wishlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/wishlist/:productId", "host": ["{{baseUrl}}"], "path": ["api", "user", "wishlist", ":productId"], "variable": [{ "key": "productId", "value": "product_uuid_here" }] }
          }
        },
        {
          "name": "Remove Product from Wishlist",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/wishlist/:productId", "host": ["{{baseUrl}}"], "path": ["api", "user", "wishlist", ":productId"], "variable": [{ "key": "productId", "value": "product_uuid_here" }] }
          }
        },
        {
          "name": "Get User Submitted Reviews",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/reviews", "host": ["{{baseUrl}}"], "path": ["api", "user", "reviews"] }
          }
        },
        {
          "name": "Submit Product Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"product_uuid_here\",\n  \"rating\": 5,\n  \"review\": \"Outstanding craftsmanship and prompt delivery!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/user/reviews", "host": ["{{baseUrl}}"], "path": ["api", "user", "reviews"] }
          }
        },
        {
          "name": "Get Vendor Application Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/user/vendor-request", "host": ["{{baseUrl}}"], "path": ["api", "user", "vendor-request"] }
          }
        },
        {
          "name": "Submit Vendor Application",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopName\": \"Artisan Potteries\",\n  \"phone\": \"+1987654321\",\n  \"email\": \"artisan@example.com\",\n  \"address\": \"789 Artisan Way, Studio 3\",\n  \"description\": \"Specialized in handcrafted ceramic dinnerware.\",\n  \"banner\": \"https://example.com/banner.jpg\",\n  \"fbLink\": \"https://facebook.com/artisan\",\n  \"instaLink\": \"https://instagram.com/artisan\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/user/vendor-request", "host": ["{{baseUrl}}"], "path": ["api", "user", "vendor-request"] }
          }
        }
      ]
    },
    {
      "name": "03. Storefront Discovery & Content",
      "item": [
        {
          "name": "Homepage Curated Data",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/home", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "home"] }
          }
        },
        {
          "name": "Search & Filter Products Catalog",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/storefront/products?page=1&limit=12&search=&category=&brand=&minPrice=10&maxPrice=500&sort=price_low",
              "host": ["{{baseUrl}}"],
              "path": ["api", "storefront", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" },
                { "key": "search", "value": "" },
                { "key": "category", "value": "" },
                { "key": "brand", "value": "" },
                { "key": "minPrice", "value": "10" },
                { "key": "maxPrice", "value": "500" },
                { "key": "sort", "value": "price_low" }
              ]
            }
          }
        },
        {
          "name": "Product Details by Slug",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/products/:slug", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "products", ":slug"], "variable": [{ "key": "slug", "value": "product-slug-here" }] }
          }
        },
        {
          "name": "Public Vendors Directory",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/vendors", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "vendors"] }
          }
        },
        {
          "name": "Active Flash Sale Event",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/flash-sale", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "flash-sale"] }
          }
        },
        {
          "name": "Category Hierarchy Tree",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/categories", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "categories"] }
          }
        },
        {
          "name": "Brands Directory",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/brands", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "brands"] }
          }
        },
        {
          "name": "Blog Articles List",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/blogs?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "blogs"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Blog Article by Slug",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/blogs/:slug", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "blogs", ":slug"], "variable": [{ "key": "slug", "value": "blog-slug-here" }] }
          }
        },
        {
          "name": "Add Blog Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Insightful post regarding sustainable artisan craft!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/storefront/blogs/:id/comments", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "blogs", ":id", "comments"], "variable": [{ "key": "id", "value": "blog_id_here" }] }
          }
        },
        {
          "name": "Advertisements & Promotional Banners",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/advertisements", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "advertisements"] }
          }
        },
        {
          "name": "Subscribe to Newsletter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"subscriber@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/storefront/newsletter-subscribe", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "newsletter-subscribe"] }
          }
        },
        {
          "name": "Verify Newsletter Subscriber Token",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/storefront/newsletter-verify/:token", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "newsletter-verify", ":token"], "variable": [{ "key": "token", "value": "verification_token_here" }] }
          }
        },
        {
          "name": "Submit Contact Inquiry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah@example.com\",\n  \"subject\": \"Custom Wholesale Order\",\n  \"message\": \"Looking to place a bulk custom ceramic order for our studio.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/storefront/contact", "host": ["{{baseUrl}}"], "path": ["api", "storefront", "contact"] }
          }
        }
      ]
    },
    {
      "name": "04. Orders & Checkout",
      "item": [
        {
          "name": "Calculate Pricing & Coupon Engine",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"product_uuid\",\n      \"qty\": 2,\n      \"unitPrice\": 49.99,\n      \"variants\": [{ \"name\": \"Color\", \"value\": \"Blue\" }]\n    }\n  ],\n  \"couponCode\": \"SUMMER15\",\n  \"shippingRuleId\": \"shipping_rule_uuid\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/order/calculate-pricing", "host": ["{{baseUrl}}"], "path": ["api", "order", "calculate-pricing"] }
          }
        },
        {
          "name": "Checkout & Place Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"product_uuid\",\n      \"qty\": 1,\n      \"unitPrice\": 49.99,\n      \"variants\": []\n    }\n  ],\n  \"addressId\": \"address_uuid\",\n  \"shippingRuleId\": \"shipping_rule_uuid\",\n  \"couponCode\": \"SUMMER15\",\n  \"paymentMethod\": \"COD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/order/checkout", "host": ["{{baseUrl}}"], "path": ["api", "order", "checkout"] }
          }
        },
        {
          "name": "Customer Orders History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/order/user/orders", "host": ["{{baseUrl}}"], "path": ["api", "order", "user", "orders"] }
          }
        },
        {
          "name": "Public Order Tracking by Invoice ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/order/track/:invoiceId", "host": ["{{baseUrl}}"], "path": ["api", "order", "track", ":invoiceId"], "variable": [{ "key": "invoiceId", "value": "1001" }] }
          }
        }
      ]
    },
    {
      "name": "05. Vendor Portal",
      "item": [
        {
          "name": "Vendor Dashboard Metrics",
          "request": {
