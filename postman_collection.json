            "url": { "raw": "{{baseUrl}}/api/vendor/products/:productId/variants", "host": ["{{baseUrl}}"], "path": ["api", "vendor", "products", ":productId", "variants"], "variable": [{ "key": "productId", "value": "product_id" }] }
          }
        },
