{
  "info": {
    "name": "E-Commerce Platform API",
    "_postman_id": "ecom-api-complete-suite-v1",
    "description": "Complete Postman collection covering all REST API endpoints across Customer Accounts, Storefront Discovery, Order & Checkout, Admin Control Panel, and Real-Time Chat.",
