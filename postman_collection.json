        },
        {
          "name": "Get Shop Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/vendor/shop-profile", "host": ["{{baseUrl}}"], "path": ["api", "vendor", "shop-profile"] }
