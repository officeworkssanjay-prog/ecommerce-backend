              "mode": "raw",
              "raw": "{\n  \"name\": \"Handcrafted Ceramic Mug\",\n  \"categoryId\": \"category_id\",\n  \"price\": 24.99,\n  \"qty\": 20,\n  \"shortDescription\": \"Stoneware coffee mug\",\n  \"thumbImage\": \"https://example.com/mug.jpg\"\n}"
