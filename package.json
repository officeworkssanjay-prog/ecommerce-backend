{
  "name": "ecommerce-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Vendor E-Commerce Platform built with Next.js, Node.js, PostgreSQL, Tailwind CSS, and shadcn/ui",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "npm@10.0.0"
}
