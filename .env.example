# ---------------------------------------------------------------------------
# Copy to .env (root) and also to apps/backend/.env. Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecommerce_db?schema=public"

# --- API (apps/backend) ---
PORT=5000
# REQUIRED: the API refuses to start without it. Use 32+ random characters.
JWT_SECRET=""
# Origin allowed by CORS (only matters when the browser calls the API directly)
FRONTEND_URL="http://localhost:3000"

# Online payments (Razorpay). Optional: without both keys only cash on delivery is offered.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Web app (apps/frontend) ---
# Where the Next.js server proxies /api/* and /uploads/* to
BACKEND_ORIGIN="http://localhost:5000"
# Store currency used to display prices (the API stores plain numbers)
NEXT_PUBLIC_CURRENCY_CODE="INR"
NEXT_PUBLIC_LOCALE="en-IN"
