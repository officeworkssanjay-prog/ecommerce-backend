# PostgreSQL Database Connection URL
# Replace with your actual PostgreSQL credentials:
# postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"

# Node.js API Port & Secrets
PORT=5000
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"

# (Optional) NextAuth & Payment Gateway Test Credentials
NEXTAUTH_SECRET="super-secret-nextauth-key-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Pusher Channels (Optional / Real-Time Chat)
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_APP_KEY="your_pusher_app_key"
PUSHER_APP_SECRET="your_pusher_app_secret"
PUSHER_APP_CLUSTER="mt1"
